{
  "manifest_version": 3,
  "name": "FinPull - Personal Financial Dashboard",
  "version": "1.0.0",
  "description": "Securely track bank balances, transactions, and investments via Plaid and sync live numbers to Google Sheets.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FinPull Dashboard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ]
}

