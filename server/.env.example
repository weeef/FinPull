# Plaid API Credentials
# Get these from your Plaid Dashboard: https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_sandbox_secret_here

# Plaid Environment: 'sandbox' (testing with fake banks) or 'development' (real bank accounts)
PLAID_ENV=sandbox

# Local Server Port (default 3000)
PORT=3000

# Chrome Extension ID for CORS security
# After loading the extension in chrome://extensions, copy the Extension ID and paste it here.
# Example: EXTENSION_ID=abcdefghijklmnopqrstuvwxyz123456
# Leave empty or commented out during initial setup to allow all chrome-extension:// origins locally.
EXTENSION_ID=

# Plaid Products & Country Codes
PLAID_PRODUCTS=auth,transactions,investments
PLAID_COUNTRY_CODES=US
